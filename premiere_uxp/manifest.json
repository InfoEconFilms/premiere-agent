{
  "manifestVersion": 5,
  "id": "com.econfilms.premiereagent.uxp",
  "name": "Premiere Agent",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereAgentPanel",
      "label": { "default": "Premiere Agent" },
      "minimumSize": { "width": 340, "height": 280 },
      "preferredDockedSize": { "width": 420, "height": 620 },
      "preferredFloatingSize": { "width": 460, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": "all" }
  }
}
