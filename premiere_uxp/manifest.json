{
  "manifestVersion": 5,
  "id": "com.econfilms.premiereagent.uxp",
  "name": "Premiere Agent",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereAgentPanel",
      "label": {
        "default": "Premiere Agent"
      },
      "minimumSize": {
        "width": 320,
        "height": 240
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  }
}
